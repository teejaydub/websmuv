# Django targets to share among websmuv projects.
.MAKEFLAGS += --no-print-directory

pwd := $(shell pwd)
projectPath := $(pwd)
project := $(shell basename $(projectPath))
configDir := $(projectPath)/conf

# Links the websmuv-provided Django modules where Python can find them, only if needed.
deployFile := conf/deploy.toml
djangoProject := $(shell tomlq .Django.project $(deployFile) -r)
djangoApp := $(shell tomlq .Django.mainApp $(deployFile) -r)
djangoMainDir := $(djangoProject)/$(djangoApp)
dbhost := $(shell tomlq .DB.dbhost conf/deploy.toml -r)
sqliteFile := $(shell tomlq .DB.sqliteFile conf/deploy.toml -r)

hostname := $(shell tomlq .hostname $(deployFile) -r)
ifeq ("$(hostname)", "")
hostname = localhost
endif

django-settings: $(djangoMainDir)/django_settings.py
$(djangoMainDir)/django_settings.py:
	ln -s $(shell pwd)/websmuv/django_settings.py $(djangoMainDir)/django_settings.py


#############################################################################
# Initial setup and tools for keeping code up to date.

# Install websmuv dependences as well as Django ones.
# Some of these may no longer be needed, but they're cheap.
django-depends:
	git submodule update --init
	cd websmuv; $(MAKE) depends config
	sudo apt install -y build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev llvm \
		libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev
	sudo apt install -y graphviz libpq-dev postgresql postgresql-contrib
	sudo apt install -y wget xdg-utils sqlite3

# Replace the current referenced version of Python.
# Rebuild the environment from scratch.
# Run this after changing the Python version spec in pyproject.toml.
# Then also run update-dev if this is a development install.
reinstall-python:
	uv self update
	uv python install --reinstall
	uv sync --reinstall

# Start a completely new Django project from scratch.
# Relies on deploy.toml settings for names.
# Requires django-depends first.
django-new:
	cp websmuv/django-default/pyproject.toml .
	tomlq -t '.project.name = $(djangoProject)' pyproject.toml | sponge pyproject.toml
	cp websmuv/django-default/.gitignore .
	echo "$(djangoMainDir)/django_settings.py" >> .gitignore
	$(MAKE) reinstall-python
	django-admin startproject $(djangoApp) $(djangoProject)
	sed -i '1ifrom .django_settings import *" $(djangoMainDir)/settings.py
	cp websmuv/django-default/nginx-app.conf.template conf/

# Copies all static files provided by apps into a single hierarchy for hosting by a local web server.
collectstatic: django-settings
	mkdir -p $(djangoProject)/static/
	cd $(djangoProject) && uv run manage.py collectstatic --noinput

# If you've added migrations, this applies them to the database.
migrate: django-settings
	cd $(djangoProject) && uv run manage.py migrate


#######################################################################
# Testing and development tools

# Runs the local server, with automatic reload for easy development.
run:
	cd $(djangoProject) && DEBUG=1 uv run manage.py runserver

# Runs with debugging turned off - useful for testing production logging.
prod-run:
	cd $(djangoProject) && uv run manage.py runserver

# Allows pdb debugging at breakpoint()s.
debug-run:
	# Enter 'c' to start the program running.
	cd $(djangoProject) && DEBUG=1 uv run -m pdb manage.py runserver

# Runs the local server with all DEBUG log messages sent to the console.
debug-log-run:
	export DJANGO_LOG_LEVEL=DEBUG && cd $(djangoProject) && DEBUG=1 uv run manage.py runserver

# Opens a browser to the local server to view the site from e.g. `make run`.
# Under WSL, you'll need to do something like this in .bashrc:
# open_url() {
#   powershell.exe -Command "Start-Process '$1'"
# }
# export BROWSER=open_url
browse:
	xdg-open http://localhost:8000

# Runs all unit tests, with warnings on.
# Also reformats and checks structure.
# Requires ruff.
test:
	uvx ruff format
	cd $(djangoProject) && uv run python -Wa manage.py test --keepdb --failfast --pdb
	uvx ruff check

# Runs all unit tests, and tests migrations by rebuilding the test database.
test-migrations:
	cd $(djangoProject) && uv run python -Wa manage.py test --failfast --noinput

# Send a test email to the deployment's configured email address.
test-mail:
	cd $(djangoProject) && uv run python manage.py sendtestemail $(shell tomlq .email $(deployFile) -r)
	
# Update the environment with new modules or schema updates.
update-dev:
	uv sync --dev
	$(MAKE) collectstatic
	$(MAKE) migrate

# Update the environment for running as a server.
# You should probably be running update-server, but it's here for comparison with update-dev.
update-run:
	uv sync --no-dev
	$(MAKE) collectstatic
	$(MAKE) migrate

# Upgrade all packages to their latest available versions.
upgrade:
	uv self update
	uv sync --upgrade --dev
	git submodule update --recursive

# Do this after editing models; then you should probably inspect the migrations.
# And when you're done modifying the database, it's handy to make model-viz.
migrations:
	cd $(djangoProject) && uv run manage.py makemigrations --dry-run
	cd $(djangoProject) && echo "" | xargs -p uv run manage.py makemigrations
	$(MAKE) model-viz

# Update the graph of the models - for just the interesting ones.
# Requires django-extensions and pydot.
model-viz:
	cd $(djangoProject) && DEBUG=1 uv run manage.py graph_models \
		$(shell tomlq .Django.modelVizApps $(deployFile) -r) \
		-o ../model-viz.png

# Run Python commands with all the model classes loaded.
# Requires django-extensions.
shell:
	cd $(djangoProject) && DEBUG=1 uv run manage.py shell_plus


#############################################################################
# Database management, particularly for managing Postgres vs. SQLite support.

# Initial setup for using Postgres as the database backend.
# Create the Postgres user and database for Django.
# (Don't set the host if it's localhost, because that will prevent setting password properly.)
create-database-pg:
	@echo "Unlabeled password prompts below will be for the new Postgres user password."
	createuser -h $(dbhost) -U postgres -l -d -P $(shell tomlq .DB.dbUser conf/deploy.toml -r)
	@echo "Unlabeled password prompts below will be for the new Postgres user password."
	createdb -h $(dbhost) -U $(shell tomlq .DB.dbUser conf/deploy.toml -r) \
		-O $(shell tomlq .DB.dbUser conf/deploy.toml -r) \
		$(shell tomlq .DB.dbName conf/deploy.toml -r)

# Whatever database, we're using, finish first-time setup from the Django side.
setup-database: django-settings
	make collectstatic migrate
	cd $(djangoProject) && uv run manage.py createsuperuser

# View the current database via SQL commands in the current database engine.
sql:
	cd $(djangoProject) && DEBUG=1 uv run manage.py dbshell

# View the SQLite database.
sql-sqlite:
	cd $(djangoProject) && DEBUG=1 uv run manage.py dbshell --database=sqlite

# View the Postgres database.
sql-pg:
	cd $(djangoProject) && DEBUG=1 uv run manage.py dbshell --database=pg

# Change to using the Postgres server for the database.
db-use-pg:
	tomlq -t '.DB.sqlite = false' $(deployFile) | sponge $(deployFile)
# Change to using SQLite for the database.
db-use-sqlite:
	tomlq -t '.DB.sqlite = true' $(deployFile) | sponge $(deployFile)

# Runs a full SQLite checkpoint - blocks until no writers or old readers.
# Makes the single .db file contain consistent data (esp. if Write-Ahead Log is used).
# Does no harm if we're currently using Postgres.
db-sync-full:
	sqlite3 $(sqliteFile) 'PRAGMA wal_checkpoint(FULL); vacuum;'

# Make a backup of the SQLite database.
# Requires that the database isn't being used currently.
db-backup: db-sync-full
	cp $(sqliteFile) $(sqliteFile)-bak --backup=numbered
# Restore the most recent backup over the current database.
# Requires that the database isn't being used currently.
db-restore: db-sync-full
	cp $(sqliteFile)-bak $(sqliteFile)


# Clone the Postgres database to SQLite.
# Use the -server variant below on a live server, to ensure it's not disturbed by other users during the process.
sync-to-sqlite:
	cp $(sqliteFile) $(sqliteFile)-bak
	cd $(djangoProject) && uv run manage.py flush --database=sqlite
	cd $(djangoProject) && uv run manage.py migrate --database=sqlite
	cd $(djangoProject) && uv run manage.py dumpdata --database=pg --natural-foreign --natural-primary \
		| uv run manage.py loaddata --database=sqlite --format=json -

# Clone the SQLite database to Postgres.
# Use the -server variant below on a live server, to ensure it's not disturbed by other users during the process.
sync-to-pg:
	@echo
	@echo "This will replace ALL CONTENTS of the configured Postgres database, $(dbhost):$(shell tomlq .dbName conf/deploy.toml -r)."
	@make confirm
	cd $(djangoProject) && uv run manage.py flush --database=pg
	cd $(djangoProject) && uv run manage.py migrate --database=pg
	cd $(djangoProject) && uv run manage.py dumpdata --database=sqlite --natural-foreign --natural-primary \
		| uv run manage.py loaddata --database=pg --format=json -


#############################################################################
# Database copying; run from development, but affects server instance.

# Installs a local copy of the current server database.
# Backs up both local and server, then replaces the local current DB with the server's backup.
# Puts the server in maintenance mode while working, in order to get a clean copy.
grab-server-data:
	ssh -i $(configDir)/server.pem ubuntu@$(hostname) "bash -l -c 'cd $(project); make lock-db db-backup unlock-db'"
	make grab-server-backup

# Same, but just grabs the most recent backup that's already on the server.
grab-server-backup:
	make db-backup
	scp -i $(configDir)/server.pem ubuntu@$(hostname):$(project)/$(sqliteFile)-bak $(sqliteFile)

# Same, but grabs the current live backup, requiring the caller to take care of explicit locking/unlocking.
grab-server-data-live:
	scp -i $(configDir)/server.pem ubuntu@$(hostname):$(project)/$(sqliteFile) $(sqliteFile)
lock-server-data:
	ssh -t -i $(configDir)/server.pem ubuntu@$(hostname) "bash -l -c 'cd $(project); make lock-db db-sync-full'"
unlock-server-data:
	ssh -t -i $(configDir)/server.pem ubuntu@$(hostname) "bash -l -c 'cd $(project); make unlock-db'"

# Copy the current SQLite database from the development machine up to the server.
# Makes a backup of the current SQLite backup on the server first.
# This is probably only useful when you're starting production for the first time!
# Though conceivably you could also copy a database down to development, fix it, then copy it back up.
publish-db-to-server:
	@echo
	@echo "This will replace the SQLite database on the **server**, $(hostname), with the local copy."
	@make confirm
	ssh -t -i $(configDir)/server.pem ubuntu@$(hostname) "bash -l -c 'cd $(project); make lock-db db-backup'"
	$(MAKE) publish-db-to-server-live
	ssh -t -i $(configDir)/server.pem ubuntu@$(hostname) "bash -l -c 'cd $(project); make unlock-db'"
# Same with no backups and no locking protection.
publish-db-to-server-live:
	scp -i $(configDir)/server.pem $(sqliteFile) ubuntu@$(hostname):$(project)/$(sqliteFile)


#############################################################################
# Database maintenance, generally run only on the server.

# Ensure the database server is active, for use before we stop the server.
spin-up-postgres:
	cd $(djangoProject) && uv run manage.py dbshell --database=pg -- -c "SELECT COUNT(*) FROM auth_user;" 

# Lock the database to work with its files directly.
# This also stops the Django server gracefully and puts it in maintenance mode.
lock-db:
	$(MAKE) https-maintenance
	$(MAKE) stop
unlock-db:
	$(MAKE) start
	$(MAKE) https-normal

# Clone the Postgres database to SQLite.
# You should make sure any other servers using the same Postgres database are stopped first.
sync-to-sqlite-server:
	make spin-up-postgres
	$(MAKE) lock-db
	$(MAKE) sync-to-sqlite
	$(MAKE) unlock-db

# Clone the SQLite database to Postgres.
# You should make sure any other servers using the same Postgres database are stopped first.
sync-to-pg-server:
	$(MAKE) spin-up-postgres
	$(MAKE) lock-db
	$(MAKE) sync-to-pg
	$(MAKE) unlock-db

# Switches a live server database over from SQLite to Postgres,
# syncing the database over in the process, locking it while doing so.
# Updates the deploy.toml file, so the server will be out of sync with Git afterward.
db-move-sqlite-to-pg:
	$(MAKE) spin-up-postgres
	$(MAKE) lock-db
	$(MAKE) sync-to-pg
	$(MAKE) db-use-pg
	$(MAKE) unlock-db

# Same, but in the other direction.
db-move-pg-to-sqlite:
	$(MAKE) spin-up-postgres
	$(MAKE) lock-db
	$(MAKE) sync-to-sqlite
	$(MAKE) db-use-sqlite
	$(MAKE) unlock-db


#######################################################################
# Server-side management.

# All the one-time setup for production use: Nginx, firewall, Fail2Ban, Certbot, etc.
# Requires conf/deploy.toml, as described in `websmuv/README.md`.
django-setup-prod:
	cd websmuv && $(MAKE) install
	chmod 755 ~  # Allows nginx to host files within ~/project/app/static

# Update all the code on the server, and cycle the running server down and back up again to activate it.
update-server:
	uv self update
	git pull --recurse-submodules
	$(MAKE) build-server

# Used to provide settings.DEPLOY_DATE for use in templates.
deploy-date:
	date -Iminutes > deploy-date.txt

# Rebuild the deployment, with a new date, and ensure everything's up to date.
# Recover after a bad update-server by "git checkout <previous tag name>", then running this.
build-server: django-settings
	$(MAKE) websmuv-update-start
	$(MAKE) deploy-date
	-$(MAKE) stop
	$(MAKE) update-run
	$(MAKE) gunicorn-asgi
	$(MAKE) gunicorn-install
	$(MAKE) websmuv-update-middle
	$(MAKE) restart
	$(MAKE) websmuv-update-end
	$(MAKE) server-status

start:
	sudo systemctl start gunicorn.socket
	sudo systemctl enable gunicorn.socket

stop:
	-sudo systemctl stop gunicorn.socket
	-sudo systemctl stop gunicorn

restart:
	sudo systemctl daemon-reload
	sudo systemctl reload-or-restart gunicorn

server-status:
	sudo systemctl status gunicorn --no-pager

log:
	sudo journalctl -u gunicorn -r

last-log:
	sudo journalctl -u gunicorn -S yesterday

follow-log:
	sudo journalctl -f -u gunicorn -n 1000


#######################################################################
# Gunicorn/uvicorn setup.
# 

# Construct a gunicorn file for hosting via ASGI or WSGI.
# Requires 'make stop' first.
# ASGI is hard-coded above under build-server, so this would need to be
# further parameterized if WSGI is required.
gunicorn-wsgi: gunicorn-socket
	uv run python -m websmuv.template cwd=`pwd` user=`whoami` mainapp=$(djangoApp) api=wsgi workers=2 extra= \
		< websmuv/conf/gunicorn.service.template \
		> gunicorn.service

gunicorn-asgi: gunicorn-socket
	uv run python -m websmuv.template cwd=`pwd` user=`whoami` mainapp=$(djangoApp) api=asgi workers=1 "extra=-k uvicorn.workers.UvicornWorker" \
		< websmuv/conf/gunicorn.service.template \
		> gunicorn.service

# Customize the socket definition to place it locally.
# This allows us to not run Django as root.
# Also configures Nginx to serve Django via gunicorn/uvicorn.
gunicorn-socket:
	uv run python -m websmuv.template cwd=`pwd` user=`whoami` mainapp=$(djangoApp) \
		< websmuv/conf/gunicorn.socket.template \
		> gunicorn.socket
	uv run python -m websmuv.template cwd=`pwd` user=`whoami` mainapp=$(djangoApp) \
		< websmuv/conf/nginx-django.conf.template \
		> conf/nginx-django.conf
	uv run python -m websmuv.template cwd=`pwd` user=`whoami` mainapp=$(djangoApp) configDir=$(configDir) \
		< conf/nginx-app.conf.template \
		> conf/nginx-app.conf
	$(MAKE) https-reload

# Set up the services files for Gunicorn to run Django.
# Handles initial installation and can be run again at any time to freshen the service files.
serviceDir = /etc/systemd/system
gunicorn-install:
ifeq ("$(wildcard $(serviceDir)/gunicorn.service)", "")
	sudo ln -s $(shell pwd)/gunicorn.service $(serviceDir)/gunicorn.service
endif
ifeq ("$(wildcard $(serviceDir)/gunicorn.socket)", "")
	sudo ln -s $(shell pwd)/gunicorn.socket $(serviceDir)/gunicorn.socket
endif
